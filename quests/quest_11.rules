// https://mng.quest/quest/11/decimal-increment

// Move right until blank, then step left once to last digit
INIT 0 INIT 0 R
INIT 1 INIT 1 R
INIT 2 INIT 2 R
INIT 3 INIT 3 R
INIT 4 INIT 4 R
INIT 5 INIT 5 R
INIT 6 INIT 6 R
INIT 7 INIT 7 R
INIT 8 INIT 8 R
INIT 9 INIT 9 R

INIT _ CHECK_LAST _ L

CHECK_LAST 0 HALT 1 L
CHECK_LAST 1 HALT 2 L
CHECK_LAST 2 HALT 3 L
CHECK_LAST 3 HALT 4 L
CHECK_LAST 4 HALT 5 L
CHECK_LAST 5 HALT 6 L
CHECK_LAST 6 HALT 7 L
CHECK_LAST 7 HALT 8 L
CHECK_LAST 8 HALT 9 L
CHECK_LAST 9 CHECK_LAST 0 L
CHECK_LAST _ HALT 1 L