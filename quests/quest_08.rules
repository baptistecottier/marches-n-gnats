// 8. Text Mirror
///////////////////////////////////////////////////////////////////////////////////////////
// Move to the end of the tape, then rewind to copy the last element.                    //
// Continue rewinding to place each subsequent character after the previously moved one, //
// repeating this process until all elements are reversed.                               //
///////////////////////////////////////////////////////////////////////////////////////////

// Move to the end of the tape
INIT a INIT a R
INIT b INIT b R
INIT c INIT c R
INIT d INIT d R
INIT e INIT e R
INIT f INIT f R
INIT g INIT g R
INIT h INIT h R
INIT i INIT i R
INIT j INIT j R
INIT k INIT k R
INIT l INIT l R
INIT m INIT m R
INIT n INIT n R
INIT o INIT o R
INIT p INIT p R
INIT q INIT q R
INIT r INIT r R
INIT s INIT s R
INIT t INIT t R
INIT u INIT u R
INIT v INIT v R
INIT w INIT w R
INIT x INIT x R
INIT y INIT y R
INIT z INIT z R
INIT ä INIT ä R
INIT ö INIT ö R
INIT õ INIT õ R
INIT ü INIT ü R
INIT - INIT - R
INIT | INIT | R
INIT _ REWIND _ L


// Rewind until finding next element to move
REWIND a PLACE_a @ R
REWIND b PLACE_b @ R
REWIND c PLACE_c @ R
REWIND d PLACE_d @ R
REWIND e PLACE_e @ R
REWIND f PLACE_f @ R
REWIND g PLACE_g @ R
REWIND h PLACE_h @ R
REWIND i PLACE_i @ R
REWIND j PLACE_j @ R
REWIND k PLACE_k @ R
REWIND l PLACE_l @ R
REWIND m PLACE_m @ R
REWIND n PLACE_n @ R
REWIND o PLACE_o @ R
REWIND p PLACE_p @ R
REWIND q PLACE_q @ R
REWIND r PLACE_r @ R
REWIND s PLACE_s @ R
REWIND t PLACE_t @ R
REWIND u PLACE_u @ R
REWIND v PLACE_v @ R
REWIND w PLACE_w @ R
REWIND x PLACE_x @ R
REWIND y PLACE_y @ R
REWIND z PLACE_z @ R
REWIND ä PLACE_ä @ R
REWIND ö PLACE_ö @ R
REWIND õ PLACE_õ @ R
REWIND ü PLACE_ü @ R
REWIND - PLACE_- @ R
REWIND @ REWIND @ L
REWIND _ CLEAN _ R

// For all chars in the quest alphabet, place the found
// letter by moving right until finding an empty spot
PLACE_a a PLACE_a a R
PLACE_a b PLACE_a b R
PLACE_a c PLACE_a c R
PLACE_a d PLACE_a d R
PLACE_a e PLACE_a e R
PLACE_a f PLACE_a f R
PLACE_a g PLACE_a g R
PLACE_a h PLACE_a h R
PLACE_a i PLACE_a i R
PLACE_a j PLACE_a j R
PLACE_a k PLACE_a k R
PLACE_a l PLACE_a l R
PLACE_a m PLACE_a m R
PLACE_a n PLACE_a n R
PLACE_a o PLACE_a o R
PLACE_a p PLACE_a p R
PLACE_a q PLACE_a q R
PLACE_a r PLACE_a r R
PLACE_a s PLACE_a s R
PLACE_a t PLACE_a t R
PLACE_a u PLACE_a u R
PLACE_a v PLACE_a v R
PLACE_a w PLACE_a w R
PLACE_a x PLACE_a x R
PLACE_a y PLACE_a y R
PLACE_a z PLACE_a z R
PLACE_a ä PLACE_a ä R
PLACE_a ö PLACE_a ö R
PLACE_a õ PLACE_a õ R
PLACE_a ü PLACE_a ü R
PLACE_a - PLACE_a - R
PLACE_a @ PLACE_a @ R
PLACE_a _ PLACED a L

